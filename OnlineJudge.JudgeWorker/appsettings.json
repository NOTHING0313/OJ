{
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "JudgeSandbox": {
    "CpuLimit": 1,
    "PidsLimit": 64,
    "TempFileSystemSizeMb": 64,
    "MaxCapturedOutputBytes": 1048576
  },
  "JudgeResourcePolicy": {
    "MaxSourceCodeBytes": 524288,
    "MaxProblemTitleCharacters": 200,
    "MaxProblemContentBytes": 262144,
    "MinTimeLimitMs": 100,
    "MaxTimeLimitMs": 10000,
    "MaxDeclaredTestTimeBudgetMs": 120000,
    "MinMemoryLimitMb": 16,
    "MaxMemoryLimitMb": 512,
    "MaxTestCases": 200,
    "MaxTestCaseFieldBytes": 1048576,
    "MaxAggregateTestDataBytes": 67108864,
    "MaxImportTestCases": 200,
    "MaxImportPayloadBytes": 67108864,
    "SubmissionJudgeWallTimeSeconds": 180
  },
  "JudgeJobs": {
    "LeaseDurationSeconds": 120,
    "HeartbeatIntervalSeconds": 30,
    "PollIntervalMilliseconds": 1000,
    "MaxAttempts": 3,
    "RetryBaseDelaySeconds": 5,
    "RetryMaxDelaySeconds": 60,
    "RedisSignalTimeoutMilliseconds": 1000
  },
  "JudgeWorker": {
    "Concurrency": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
