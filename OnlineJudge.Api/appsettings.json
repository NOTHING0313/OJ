{
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "OnlineJudge.Api",
    "Audience": "OnlineJudge.Client",
    "ExpireMinutes": 120
  },
  "Email": {
    "Provider": "Smtp",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "UserName": "",
      "Password": "",
      "FromName": "Online Judge"
    }
  },
  "TeamProjects": {
    "AllowedGitHosts": [
      "github.com",
      "gitee.com",
      "gitlab.com"
    ],
    "RepositoryStorageRoot": "App_Data/team-repositories",
    "MaxCommitHistory": 300,
    "GitTimeoutSeconds": 30,
    "MaxRepositorySizeMb": 100,
    "SyncCooldownSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
