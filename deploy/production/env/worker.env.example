DOTNET_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=online_judge;Username=onlinejudge;Password=CHANGE_ME_MATCH_INFRASTRUCTURE_PASSWORD
Redis__ConnectionString=127.0.0.1:6379,abortConnect=false
JudgeWorker__Concurrency=2
JudgeAssets__StorageRoot=/var/lib/onlinejudge/judge-assets
HOME=/var/lib/onlinejudge/worker-home
TMPDIR=/var/lib/onlinejudge/worker-tmp
