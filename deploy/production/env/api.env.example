ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5101
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=online_judge;Username=onlinejudge;Password=CHANGE_ME_MATCH_INFRASTRUCTURE_PASSWORD
Redis__ConnectionString=127.0.0.1:6379,abortConnect=false
Jwt__Secret=CHANGE_ME_GENERATE_AT_LEAST_48_RANDOM_BYTES
Jwt__Issuer=OnlineJudge.Api
Jwt__Audience=OnlineJudge.Client
RootAccount__UserName=root
RootAccount__Email=CHANGE_ME_ROOT_EMAIL
RootAccount__Password=CHANGE_ME_GENERATE_A_UNIQUE_ROOT_PASSWORD
Email__Provider=Smtp
Email__Smtp__Host=CHANGE_ME_SMTP_HOST
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__UserName=CHANGE_ME_SMTP_ACCOUNT
Email__Smtp__Password=CHANGE_ME_SMTP_PASSWORD
Email__Smtp__FromName=Online Judge
Storage__UploadImagesRoot=/var/lib/onlinejudge/uploads
Storage__ChallengeFilesRoot=/var/lib/onlinejudge/challenge-files
Storage__ThemeAssetsRoot=/var/lib/onlinejudge/theme-assets
TeamProjects__RepositoryStorageRoot=/var/lib/onlinejudge/team-repositories
JudgeAssets__StorageRoot=/var/lib/onlinejudge/judge-assets
HOME=/var/lib/onlinejudge/api-home
